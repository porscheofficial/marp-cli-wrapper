{
  "scripts": {
    "audit": "pnpm audit --audit-level=moderate",
    "build": "tsc",
    "format": "prettier --write .",
    "marp": "tsx src/main.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "4.5.1",
    "@types/node": "24.19.2",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tar-fs": "3.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "packageManager": "pnpm@11.27.0"
}
