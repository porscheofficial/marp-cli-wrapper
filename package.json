{
  "scripts": {
    "audit": "pnpm audit --audit-level=moderate",
    "build": "tsc",
    "format": "prettier --write .",
    "marp": "tsx src/main.ts",
    "prepare": "husky",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
